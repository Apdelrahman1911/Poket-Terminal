# PLACEHOLDERS ONLY. Copy to /etc/pocketterminal/env (root:root, 0600).
# Compatible with systemd EnvironmentFile AND: set -a; source FILE; set +a
# Use literal absolute paths; no shell expansion, command substitution or export.
PT_ORIGIN=https://terminal.example.com
PT_HOST=127.0.0.1
PT_PORT=3000
PT_DATA_DIR=/var/lib/pocketterminal
PT_PROJECT_ROOT=/srv/projects
PT_DEFAULT_CWD=/srv/projects/default
HOME=/root
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Optional display-only SSH hint; omit both for a local tmux attach command.
# PT_SSH_TARGET=root@vps.example.com
# PT_SSH_JUMP=operator@bastion.example.com:22

# Optional: otherwise Codex uses this owner's PRIVATE authenticated CLI defaults.
# PT_CODEX_MODEL=your-model-id
# PT_CODEX_PROVIDER=your_provider_id
# PT_CODEX_REASONING_EFFORT=high

# Optional Telegram: set BOTH pins, then privately pair; config alone cannot enable.
# Username has no @. Numeric bot ID is the token's prefix (verify with BotFather).
# PT_TELEGRAM_BOT_USERNAME=YourChosenBot
# PT_TELEGRAM_BOT_ID=123456789
# NEVER store the bot token, web password or provider credentials in this file.

# Desktop is OFF unless /etc/pocketdesktop/gateway.json explicitly opts in.
# PT_DESKTOP_ENABLED=0 forces it off even if that file enables it.
# Leave unset when using the persistent opt-in; HUP rereads the file, not this env.

# Optional KMP tools: paths supplied by your own SDK installation/license choices.
# JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64
# ANDROID_HOME=/opt/android-sdk
# ANDROID_SDK_ROOT=/opt/android-sdk
# Add SDK tools to the literal PATH above if installed; no profile auto-loading.
